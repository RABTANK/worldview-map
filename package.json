{
  "name": "worldview-map",
  "version": "3.0.0",
  "description": "虚构世界观地图：Agent 通过 MCP/HTTP 造图，人在 WebGL 画布上查看并轻量校正。共享 SQLite。",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"tsx watch src/server.ts\" \"vite\"",
    "prestart": "vite build",
    "start": "tsx src/server.ts",
    "build": "vite build",
    "seed": "tsx src/seed.ts",
    "key:create": "tsx src/cli/key-create.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "earcut": "^3.0.2",
    "fastify": "^5.6.1",
    "swagger-ui-dist": "^5.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
